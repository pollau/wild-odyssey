---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ComingSoonToast from "../components/ComingSoonToast.astro";
import EnvBadge from "../components/EnvBadge.astro";
import { basename } from "node:path";

interface Props {
	title: string;
	description?: string;
	// true only for pages that exist in all three locales (home, contact),
	// so we never advertise a language version that does not exist.
	alternates?: boolean;
}

const { title, description, alternates = false } = Astro.props;
const metaDescription =
	description ??
	"Wild Odyssey conçoit des expériences de sensibilisation à l'environnement (climat, océan, biodiversité) pour engager vos équipes.";

// Environnement : "local" en dev, sinon la valeur injectee au build par le
// workflow (main => production, toute PR => preview). Sans valeur, on suppose
// la production : ne JAMAIS afficher de pastille sur le site public par defaut.
const env = import.meta.env.DEV ? "local" : (import.meta.env.PUBLIC_ENV ?? "production");
const isProd = env === "production";

// En local on travaille souvent sur plusieurs clones en parallele (repo1,
// repo2...) : le nom du dossier sert d'identifiant d'instance, pour savoir
// d'un coup d'oeil quel onglet appartient a quel clone.
const instance = env === "local" ? basename(process.cwd()) : "";
const titlePrefix = isProd ? "" : env === "local" ? `[${instance}] ` : "[QA] ";

const site = Astro.site ?? new URL("https://www.wildodyssey.org");
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site).href;

// Bare path = current path with any /en or /es locale prefix removed.
const barePath = pathname.replace(/^\/(en|es)(?=\/|$)/, "") || "/";
const localeHref = (prefix: string) =>
	new URL((prefix + barePath).replace(/\/{2,}/g, "/"), site).href;
const hreflangs = alternates
	? [
			{ lang: "fr", href: localeHref("") },
			{ lang: "en", href: localeHref("/en") },
			{ lang: "es", href: localeHref("/es") },
			{ lang: "x-default", href: localeHref("") },
		]
	: [];
---

<!doctype html>
<html lang={Astro.currentLocale ?? "fr"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={canonical} />
		{hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
		{/* Hors prod : ne jamais laisser Google indexer une preview (contenu duplique). */}
		{!isProd && <meta name="robots" content="noindex, nofollow" />}
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{titlePrefix}{title} | Wild Odyssey</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&display=swap" rel="stylesheet" />
		{import.meta.env.PUBLIC_UMAMI_SITE_ID && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={import.meta.env.PUBLIC_UMAMI_SITE_ID}></script>}
	</head>
	<body>
		<Header alternates={alternates} />
		<slot />
		<Footer />
		<ComingSoonToast lang={Astro.currentLocale ?? "fr"} />
		{!isProd && <EnvBadge env={env === "local" ? "local" : "preview"} instance={instance} />}
	</body>
</html>
