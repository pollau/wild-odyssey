---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ComingSoonToast from "../components/ComingSoonToast.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale ?? "fr"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Wild Odyssey - Science-based sustainability workshops for teams" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Wild Odyssey</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
		{import.meta.env.PUBLIC_UMAMI_SITE_ID && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={import.meta.env.PUBLIC_UMAMI_SITE_ID}></script>}
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
		<ComingSoonToast lang={Astro.currentLocale ?? "fr"} />
	</body>
</html>
