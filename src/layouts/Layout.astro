---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ComingSoonToast from "../components/ComingSoonToast.astro";

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const metaDescription =
	description ??
	"Wild Odyssey conçoit des expériences de sensibilisation à l'environnement (climat, océan, biodiversité) pour engager vos équipes.";
---

<!doctype html>
<html lang={Astro.currentLocale ?? "fr"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" sizes="192x192" href="/assets/images/brand/favicon-192.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/assets/images/brand/favicon-96.png" />
		<link rel="apple-touch-icon" href="/assets/images/brand/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Wild Odyssey</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&display=swap" rel="stylesheet" />
		{import.meta.env.PUBLIC_UMAMI_SITE_ID && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={import.meta.env.PUBLIC_UMAMI_SITE_ID}></script>}
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
		<ComingSoonToast lang={Astro.currentLocale ?? "fr"} />
	</body>
</html>
