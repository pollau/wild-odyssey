---
// Page servie par Azure pour toute URL inconnue, via responseOverrides["404"]
// de public/staticwebapp.config.json. Astro la construit en dist/404.html.
//
// Page francaise uniquement, comme /evenements : `alternates` reste a false,
// on n'annonce pas de version /en ou /es qui n'existe pas.
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page introuvable"
  description="Cette page n'existe pas ou n'existe plus. Retrouvez l'accueil et l'agenda de Wild Odyssey."
>
  <main class="pt-[64px] lg:pt-[80px] min-h-screen bg-white flex items-center">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-28 w-full">
      <div class="max-w-xl">
        <p class="text-[13px] font-semibold tracking-widest uppercase text-[#0698c0] mb-3">
          Erreur 404
        </p>
        <h1 class="text-[28px] lg:text-[38px] font-semibold text-[#1e3676] leading-tight">
          Cette page n'existe pas
        </h1>
        <p class="mt-4 text-[15px] lg:text-[17px] text-gray-500">
          Le lien est peut-être erroné, ou la page a été déplacée depuis votre dernière visite.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href="/"
            class="inline-flex items-center justify-center bg-[#f05600] text-white text-[15px] font-semibold px-8 h-[46px] rounded-[7px] hover:bg-orange-700 transition-colors"
          >
            Retour à l'accueil
          </a>
          <a
            href="/evenements"
            class="inline-flex items-center justify-center border border-[#e5edf4] text-[#1e3676] text-[15px] font-semibold px-8 h-[46px] rounded-[7px] hover:bg-[#f7fbfe] transition-colors"
          >
            Voir l'agenda
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
