---
import HomePage from "../components/pages/HomePage.astro";
---

<HomePage lang="fr" audience="enterprise" />

<script>
  if (!localStorage.getItem("lang-chosen")) {
    const lang = navigator.language;
    if (lang.startsWith("en")) { localStorage.setItem("lang-chosen", "en"); location.href = "/en/"; }
    else if (lang.startsWith("es")) { localStorage.setItem("lang-chosen", "es"); location.href = "/es/"; }
  }
</script>
