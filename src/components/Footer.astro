---
import { t } from "../i18n/ui";
import { getEntry } from "astro:content";

const lang = Astro.currentLocale || "fr";
const prefix = lang === "fr" ? "" : `/${lang}`;

const homepageEntry = await getEntry("homepage", "index");
const contactEmail = (homepageEntry?.data.contactEmail as string) ?? "lionel.raybaud@wildodyssey.org";
---

<footer id="contact" class="relative overflow-hidden">

  <!-- Fond photo unique couvrant tout le footer -->
  <div class="absolute inset-0">
    <img src="/assets/figma/cta-bg.png" alt="" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <div class="relative z-10 flex flex-col">

    <!-- CTA -->
    <div class="py-14 lg:py-20 flex flex-col items-center gap-6 lg:gap-8 text-center px-6">
      <div>
        <h2 class="font-fraunces text-[28px] lg:text-[36px] font-semibold text-white leading-tight">
          {t(lang, "footer.ctaHeading")} <span class="text-[#f05600]">{t(lang, "footer.ctaAccent")}</span>
        </h2>
        <p class="font-aileron text-[17px] lg:text-[22px] font-semibold text-white mt-3 leading-snug">
          {t(lang, "footer.ctaBody1")}<br />
          {t(lang, "footer.ctaBody2")}
        </p>
      </div>
      <a
        href={`${prefix}/contact`}
        class="font-aileron bg-[#f05600] text-white text-[16px] lg:text-[18px] font-semibold px-8 h-[54px] lg:h-[68px] flex items-center justify-center rounded-[7px] hover:bg-orange-700 transition-colors"
      >
        {t(lang, "footer.ctaBtn")}
      </a>
    </div>

    <!-- Séparateur -->
    <div class="border-t border-white/20 mx-6 lg:mx-8"></div>

    <!-- Bottom bar -->
    <div class="py-5 px-6">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        <a href={`${prefix}/`} class="flex items-center gap-2.5">
          <img src="/assets/figma/logo-image.png" alt="Wild Odyssey" class="h-9 w-auto" />
          <span class="text-lg font-semibold">
            <span style="color:#3a9b37">WILD </span><span class="text-white">ODYSSEY</span>
          </span>
        </a>
        <p class="text-sm text-white/50">{t(lang, "footer.copyright")}</p>
        <a href={`mailto:${contactEmail}`} class="text-sm text-white/70 hover:text-white transition-colors">
          {contactEmail}
        </a>
      </div>
    </div>

  </div>
</footer>
