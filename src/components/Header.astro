---
import LanguagePicker from "./LanguagePicker.astro";
import { t } from "../i18n/ui";

const lang = Astro.currentLocale || "fr";
const prefix = lang === "fr" ? "" : `/${lang}`;
---

<header class="fixed w-full z-50 bg-white shadow-[0px_4px_12.5px_rgba(206,206,206,0.25)]" id="main-header">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-[64px] lg:h-[80px]">

      <!-- Logo -->
      <a href={`${prefix}/`} class="flex items-center gap-3 shrink-0">
        <img src="/assets/images/brand/logo-symbol.png" alt="" class="h-[56px] lg:h-[68px] w-auto" />
        <img src="/assets/images/brand/logo-text.png" alt="Wild Odyssey" class="h-[22px] lg:h-[26px] w-auto" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8 lg:gap-10">

        <!-- Language picker -->
        <div class="border border-[#f05600] rounded-full px-3 py-1.5 bg-[rgba(240,86,0,0.15)] flex items-center gap-2">
          <LanguagePicker />
        </div>

        <!-- CTA -->
        <a
          href={`${prefix}/contact`}
          class="bg-[#f05600] text-white text-[15px] lg:text-[16px] font-semibold px-6 h-[44px] lg:h-[50px] flex items-center justify-center rounded-[7px] hover:bg-orange-700 transition-colors whitespace-nowrap"
        >
          {t(lang, "nav.cta")}
        </a>
      </nav>

      <!-- Mobile burger -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-black" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-[#d9d9d9] px-6 py-4 space-y-4">
    <LanguagePicker />
<a href={`${prefix}/contact`} class="block w-full bg-[#f05600] text-white text-center font-semibold py-3 rounded-[7px]">{t(lang, "nav.cta")}</a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document.addEventListener("click", (e) => {
    if (!menu?.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
      menu?.classList.add("hidden");
    }
  });
</script>
