---
import LanguagePicker from "./LanguagePicker.astro";
import RichText from "./RichText.astro";
import { t } from "../i18n/ui";

const lang = Astro.currentLocale || "fr";
const prefix = lang === "fr" ? "" : `/${lang}`;

// Les publics du site. L accueil est la page entreprises : son lien pointe
// donc sur la racine, comme le logo, mais il est nomme, pour qu on voie qu il
// existe plusieurs versions et comment revenir aux autres. L onglet Education
// regroupe les deux pages du monde de l enseignement.
const accueil = { href: `${prefix}/`, cle: "nav.home" as const };
const education = [
  { href: `${prefix}/ecoles`, cle: "nav.schools" as const },
  { href: `${prefix}/universites`, cle: "nav.higherEd" as const },
];

// Page courante, pour souligner le public ou l on se trouve. On compare les
// chemins sans leur barre finale, qu Astro ajoute ou non selon la route.
const ici = Astro.url.pathname.replace(/\/$/, "");
const estCourant = (href: string) => ici === href.replace(/\/$/, "");
const dansEducation = education.some((p) => estCourant(p.href));

// Le soulignement est porte par tous les onglets, en transparent sur ceux qui
// dorment : sans cela l onglet actif serait plus haut que les autres, sa
// bordure poussant son texte vers le haut.
const onglet = (actif: boolean) => [
  "text-[15px] lg:text-[16px] font-semibold whitespace-nowrap transition-colors border-b-2 pb-0.5",
  actif ? "text-[#f05600] border-[#f05600]" : "text-black border-transparent hover:text-[#f05600]",
];
const lienMobile = (actif: boolean) => [
  "block text-[16px] font-semibold",
  actif ? "text-[#f05600]" : "text-black",
];
---

<header class="fixed w-full z-50 bg-white shadow-[0px_4px_12.5px_rgba(206,206,206,0.25)]" id="main-header">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-[64px] lg:h-[80px]">

      <a href={`${prefix}/`} class="flex items-center gap-6 shrink-0">
        <img src="/assets/images/brand/logo-symbol.png" alt="" class="h-[48px] lg:h-[58px] w-auto" />
        <img src="/assets/images/brand/logo-text.png" alt="Wild Odyssey" class="h-[15px] lg:h-[18px] w-auto mt-[3px] lg:mt-1" />
      </a>

      <!-- Onglets de public, centres dans l espace laisse entre le logo et les
           utilitaires. Le decalage vertical aligne le texte sur le mot
           Wild Odyssey. -->
      <nav class="hidden md:flex flex-1 items-center justify-center gap-6 lg:gap-10 translate-y-[4px]" aria-label="Nos publics">
        <a href={accueil.href} aria-current={estCourant(accueil.href) ? "page" : undefined} class:list={onglet(estCourant(accueil.href))}>
          <RichText text={t(lang, accueil.cle)} />
        </a>

        <!-- Onglet Education : s ouvre au survol avec une souris, au toucher
             sur tablette, et au clavier. La marge haute du panneau sert de
             pont : le survol ne se perd pas en descendant vers les liens. -->
        <div class="edu relative">
          <button type="button" class:list={[onglet(dansEducation), "edu-toggle inline-flex items-center gap-1 cursor-pointer"]} aria-expanded="false">
            <RichText text={t(lang, "nav.education")} />
            <svg class="edu-arrow w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="edu-panel absolute left-1/2 -translate-x-1/2 top-full pt-3">
            <ul class="bg-white rounded-xl shadow-xl border border-gray-100 py-2 min-w-[240px]">
              {education.map((p) => (
                <li>
                  <a
                    href={p.href}
                    aria-current={estCourant(p.href) ? "page" : undefined}
                    class:list={[
                      "block px-5 py-3 text-[15px] font-semibold whitespace-nowrap transition-colors hover:bg-gray-50",
                      estCourant(p.href) ? "text-[#f05600]" : "text-black hover:text-[#f05600]",
                    ]}
                  >
                    <RichText text={t(lang, p.cle)} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>

      <!-- Utilitaires, groupes a droite -->
      <div class="hidden md:flex items-center gap-8 lg:gap-10 shrink-0">

        <!-- Language picker -->
        <div class="border border-[#f05600] rounded-full px-3 py-1.5 bg-[rgba(240,86,0,0.15)] flex items-center gap-2">
          <LanguagePicker />
        </div>

        <!-- CTA -->
        <a
          href={`${prefix}/contact`}
          class="bg-[#f05600] text-white text-[15px] lg:text-[16px] font-semibold px-6 h-[44px] lg:h-[50px] flex items-center justify-center rounded-[7px] hover:bg-orange-700 transition-colors whitespace-nowrap"
        >
          <RichText text={t(lang, "nav.cta")} />
        </a>
      </div>

      <!-- Mobile burger -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-black" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu : pas de survol sur un telephone, les deux pages de
       l onglet Education sont donc affichees directement sous son nom. -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-[#d9d9d9] px-6 py-4 space-y-4">
    <LanguagePicker />
    <a href={accueil.href} aria-current={estCourant(accueil.href) ? "page" : undefined} class:list={lienMobile(estCourant(accueil.href))}>
      <RichText text={t(lang, accueil.cle)} />
    </a>
    <div>
      <p class="text-[16px] font-semibold text-black">
        <RichText text={t(lang, "nav.education")} />
      </p>
      <div class="mt-3 pl-4 border-l-2 border-[#f05600]/30 space-y-3">
        {education.map((p) => (
          <a href={p.href} aria-current={estCourant(p.href) ? "page" : undefined} class:list={lienMobile(estCourant(p.href))}>
            <RichText text={t(lang, p.cle)} />
          </a>
        ))}
      </div>
    </div>
    <a href={`${prefix}/contact`} class="block w-full bg-[#f05600] text-white text-center font-semibold py-3 rounded-[7px]"><RichText text={t(lang, "nav.cta")} /></a>
  </div>
</header>

<style>
  /* Panneau Education : ferme par defaut, ouvert au survol (seulement sur
     les ecrans qui ont une souris, sinon le survol reste colle apres un
     toucher) ou quand le bouton l a ouvert (data-open, pose par le script). */
  .edu-panel {
    display: none;
  }
  .edu[data-open] .edu-panel {
    display: block;
  }
  .edu[data-open] .edu-arrow {
    transform: rotate(180deg);
  }
  @media (hover: hover) {
    .edu:hover .edu-panel {
      display: block;
    }
    .edu:hover .edu-arrow {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document.addEventListener("click", (e) => {
    if (!menu?.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
      menu?.classList.add("hidden");
    }
  });

  // Onglet Education. Avec une souris le survol suffit ; le bouton sert aux
  // ecrans tactiles et au clavier. Un clic ailleurs, la touche Echap, la
  // souris qui s en va ou le focus qui sort du menu le referment.
  const edu = document.querySelector<HTMLElement>(".edu");
  const eduBtn = edu?.querySelector<HTMLButtonElement>(".edu-toggle");
  if (edu && eduBtn) {
    const basculer = (ouvert: boolean) => {
      edu.toggleAttribute("data-open", ouvert);
      eduBtn.setAttribute("aria-expanded", String(ouvert));
    };
    eduBtn.addEventListener("click", () => basculer(!edu.hasAttribute("data-open")));
    edu.addEventListener("mouseleave", () => basculer(false));
    edu.addEventListener("focusout", (e) => {
      if (!edu.contains(e.relatedTarget as Node | null)) basculer(false);
    });
    document.addEventListener("click", (e) => {
      if (!edu.contains(e.target as Node)) basculer(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && edu.hasAttribute("data-open")) {
        basculer(false);
        eduBtn.focus();
      }
    });
  }
</script>
