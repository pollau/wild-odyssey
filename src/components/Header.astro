---
import LanguagePicker from "./LanguagePicker.astro";
import RichText from "./RichText.astro";
import { t } from "../i18n/ui";

const lang = Astro.currentLocale || "fr";
const prefix = lang === "fr" ? "" : `/${lang}`;

// Les deux publics du site. L accueil est la page entreprises : son lien
// pointe donc sur la racine, comme le logo, mais il est nomme, pour qu on
// voie qu il existe deux versions et comment revenir a l autre.
const publics = [
  { href: `${prefix}/`, cle: "nav.home" as const },
  { href: `${prefix}/universites`, cle: "nav.university" as const },
];

// Page courante, pour souligner le public ou l on se trouve. On compare les
// chemins sans leur barre finale, qu Astro ajoute ou non selon la route.
const ici = Astro.url.pathname.replace(/\/$/, "");
const estCourant = (href: string) => ici === href.replace(/\/$/, "");
---

<header class="fixed w-full z-50 bg-white shadow-[0px_4px_12.5px_rgba(206,206,206,0.25)]" id="main-header">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-[64px] lg:h-[80px]">

      <a href={`${prefix}/`} class="flex items-center gap-6 shrink-0">
        <img src="/assets/images/brand/logo-symbol.png" alt="" class="h-[48px] lg:h-[58px] w-auto" />
        <img src="/assets/images/brand/logo-text.png" alt="Wild Odyssey" class="h-[15px] lg:h-[18px] w-auto mt-[3px] lg:mt-1" />
      </a>

      <!-- Liens de public, centres dans l espace laisse entre le logo et les
           utilitaires. Le soulignement est porte par tous les liens, en
           transparent sur ceux qui dorment : sans cela le lien actif serait
           plus haut que l autre, sa bordure poussant son texte vers le haut.
           Le decalage vertical aligne le texte sur le mot Wild Odyssey. -->
      <nav class="hidden md:flex flex-1 items-center justify-center gap-6 lg:gap-10 translate-y-[4px]" aria-label="Nos publics">
        {publics.map((p) => (
          <a
            href={p.href}
            aria-current={estCourant(p.href) ? "page" : undefined}
            class:list={[
              "text-[15px] lg:text-[16px] font-semibold whitespace-nowrap transition-colors border-b-2 pb-0.5",
              estCourant(p.href)
                ? "text-[#f05600] border-[#f05600]"
                : "text-black border-transparent hover:text-[#f05600]",
            ]}
          >
            <RichText text={t(lang, p.cle)} />
          </a>
        ))}
      </nav>

      <!-- Utilitaires, groupes a droite -->
      <div class="hidden md:flex items-center gap-8 lg:gap-10 shrink-0">

        <!-- Language picker -->
        <div class="border border-[#f05600] rounded-full px-3 py-1.5 bg-[rgba(240,86,0,0.15)] flex items-center gap-2">
          <LanguagePicker />
        </div>

        <!-- CTA -->
        <a
          href={`${prefix}/contact`}
          class="bg-[#f05600] text-white text-[15px] lg:text-[16px] font-semibold px-6 h-[44px] lg:h-[50px] flex items-center justify-center rounded-[7px] hover:bg-orange-700 transition-colors whitespace-nowrap"
        >
          <RichText text={t(lang, "nav.cta")} />
        </a>
      </div>

      <!-- Mobile burger -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-black" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-[#d9d9d9] px-6 py-4 space-y-4">
    <LanguagePicker />
    {publics.map((p) => (
      <a
        href={p.href}
        aria-current={estCourant(p.href) ? "page" : undefined}
        class:list={["block text-[16px] font-semibold", estCourant(p.href) ? "text-[#f05600]" : "text-black"]}
      >
        <RichText text={t(lang, p.cle)} />
      </a>
    ))}
    <a href={`${prefix}/contact`} class="block w-full bg-[#f05600] text-white text-center font-semibold py-3 rounded-[7px]"><RichText text={t(lang, "nav.cta")} /></a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  document.addEventListener("click", (e) => {
    if (!menu?.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
      menu?.classList.add("hidden");
    }
  });
</script>
