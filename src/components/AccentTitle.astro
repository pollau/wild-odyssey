---
// Rend un titre a plusieurs couleurs a partir d'une seule chaine.
// Voir src/i18n/accent.ts pour la convention d'ecriture.
import { accentBits } from "../i18n/accent";

interface Props {
	text: string;
	// Classes de couleur, pour les rares titres qui s'ecartent de la charte.
	primary?: string;
	secondary?: string;
}

const { text, primary = "text-[#f05600]", secondary = "text-[#47cdf2]" } = Astro.props;
---
{accentBits(text).map((bit) =>
	bit.kind === "break" ? (
		<br />
	) : bit.kind === "plain" ? (
		bit.text
	) : (
		<span class={bit.kind === "primary" ? primary : secondary}>{bit.text}</span>
	)
)}
