---
import Layout from "../../layouts/Layout.astro";
import OrganizationSchema from "../OrganizationSchema.astro";
import { getCollection, getEntry } from "astro:content";
import { t } from "../../i18n/ui";
import { accentParts } from "../../i18n/accent";
import StatCounter from "../StatCounter.astro";
import { ACTIVITY_IMAGES } from "../../content/activityImages";

interface Props {
  lang: string;
  audience: string;
}

const { lang } = Astro.props;

const homepageEntry = await getEntry("homepage", "index");
const homepage = homepageEntry!.data;
// Chaque thematique porte un bloc par langue. On lit la langue courante
// sans repli : une carte non traduite doit se voir, pas afficher de l'anglais.
const card = (w: { data: Record<string, unknown> }) =>
  (w.data[lang] ?? {}) as Record<string, string>;
// Le rang est porte par le nom de fichier (thematic-01-...), seule source de
// l'ordre d'affichage. La photo, elle, est retrouvee sans le rang, pour qu'une
// renumerotation ne la perde pas.
const photo = (id: string) => ACTIVITY_IMAGES[id.replace(/^thematic-\d+-/, "")];
const workshops = (await getCollection("activities"))
  .sort((a, b) => a.id.localeCompare(b.id));

// Bandeau d'introduction : tout le bloc vient du JSON pilote par Keystatic,
// groupe par langue. On lit uniquement la langue courante, SANS repli sur
// l'anglais. Keystatic omet les champs vides du JSON, donc "cle absente"
// veut dire "pas de texte dans cette langue" et non "pas encore traduit" :
// un repli afficherait de l'anglais sur les pages FR et ES.
const intro = (homepage[lang as "fr" | "en" | "es"] ?? {}) as Record<string, string>;
// Chiffres de la section STATS. Volontairement hors Keystatic : ils sont
// animes par StatCounter, qui a besoin de nombres et non de texte libre.
// Les mettre a jour demande un commit.
const STATS = [
  { value: 600000, labelKey: "stats.participants" },
  { value: 2000, labelKey: "stats.organizations" },
  { value: 5, labelKey: "stats.years" },
] as const;

const features = [
  { icon: "/assets/figma/icon-clock.svg", label: t(lang, "formats.feat1") },
  { icon: "/assets/figma/icon-organic.svg", label: t(lang, "formats.feat2") },
  { icon: "/assets/figma/icon-customize.svg", label: t(lang, "formats.feat3") },
  { icon: "/assets/figma/icon-online.svg", label: t(lang, "formats.feat4") },
  { icon: "/assets/figma/icon-leader.svg", label: t(lang, "formats.feat5") },
  { icon: "/assets/figma/icon-organization.svg", label: t(lang, "formats.feat6") },
];

const reasons = [
  { icon: "👥", title: t(lang, "reasons.r1.title"), accent: t(lang, "reasons.r1.accent"), text: t(lang, "reasons.r1.text") },
  { icon: "💡", title: t(lang, "reasons.r2.title"), accent: t(lang, "reasons.r2.accent"), text: t(lang, "reasons.r2.text") },
  { icon: "💪", title: t(lang, "reasons.r3.title"), accent: t(lang, "reasons.r3.accent"), text: t(lang, "reasons.r3.text") },
  { icon: "🌿", title: t(lang, "reasons.r4.title"), accent: t(lang, "reasons.r4.accent"), text: t(lang, "reasons.r4.text") },
  { icon: "🎓", title: t(lang, "reasons.r5.title"), accent: t(lang, "reasons.r5.accent"), text: t(lang, "reasons.r5.text") },
  { icon: "🏅", title: t(lang, "reasons.r6.title"), accent: t(lang, "reasons.r6.accent"), text: t(lang, "reasons.r6.text") },
];

const prefix = lang === "fr" ? "" : `/${lang}`;
---

<Layout title={t(lang, "seo.home.title")} description={t(lang, "seo.home.description")} alternates>
  <OrganizationSchema />
  <main class="pt-[80px]">

    <!-- ─── HERO ─── -->
    <section class="bg-white py-12 lg:py-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-10 lg:gap-14">
        <!-- Text -->
        <div class="flex-1 flex flex-col gap-6 lg:gap-8">
          {intro.titleBase && <p class="font-fraunces text-[28px] lg:text-[36px] font-bold leading-tight text-black">{intro.titleBase}</p>}
          <h1 class="font-fraunces text-[28px] lg:text-[36px] font-bold leading-tight">
            <span class="text-[#f05600]">{intro.title}</span>
          </h1>
          <div class="font-aileron flex flex-col gap-4 text-[19px] text-black leading-relaxed">
            <p>{intro.body1}</p>
            <p>{intro.body2}</p>
            {intro.body3 && <p>{intro.body3}</p>}
          </div>
          <p class="font-fraunces text-[#f05600] text-[20px]">{intro.tagline}</p>
          <a
            href="#reasons"
            class="font-aileron bg-[#f05600] text-white text-[20px] font-semibold h-[54px] lg:h-[64px] w-full sm:w-[260px] flex items-center justify-center rounded-[7px] hover:bg-orange-700 transition-colors"
          >
            {intro.cta}
          </a>
        </div>
        <!-- Image -->
        <div class="w-full lg:flex-shrink-0 lg:w-auto">
          <img src="/assets/figma/hero-nature.png" alt="Wild Odyssey" class="w-full lg:w-[460px] rounded-2xl object-cover" />
        </div>
      </div>
    </section>

    <!-- ─── 6 THEMATIC WORKSHOPS ─── -->
    <section class="relative py-12 lg:py-20 overflow-hidden" style="background-color: #e8f5e5;">

      <!-- Décoration bas-droite : grand cercle blanc + photo océan intérieure -->
      <div class="absolute bottom-0 right-0 translate-x-[30%] translate-y-[30%] pointer-events-none select-none z-[1]">
        <div class="w-[400px] h-[400px] lg:w-[560px] lg:h-[560px] rounded-full bg-white/[0.28] flex items-center justify-center">
          <div class="w-[260px] h-[260px] lg:w-[360px] lg:h-[360px] rounded-full overflow-hidden">
            <img src="/assets/figma/ellipse-inner.png" alt="" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 flex flex-col gap-10 lg:gap-14 items-center">

        <!-- Header -->
        <div class="flex flex-col gap-4 lg:gap-5 items-center text-center w-full">
          <div class="bg-[rgba(6,152,192,0.15)] px-6 h-[44px] flex items-center justify-center rounded-full">
            <span class="text-[#0698c0] text-[14px] lg:text-[15px] font-semibold">{t(lang, "workshops.badge")}</span>
          </div>
          <h2 class="font-fraunces text-[24px] lg:text-[30px] font-semibold text-black">
            {accentParts(t(lang, "workshops.heading")).map((m, i) =>
                i % 2 ? <span class="text-[#f05600]">{m}</span> : m
              )}
          </h2>
          <div class="font-aileron flex flex-col gap-3 text-[15px] lg:text-[17px] font-medium text-black text-center">
            <p>{t(lang, "workshops.body1")}</p>
            <p>{t(lang, "workshops.body2")}</p>
            {t(lang, "workshops.body3") && <p>{t(lang, "workshops.body3")}</p>}
          </div>
        </div>

        <!-- Workshop cards — scroll horizontal mobile, 2×2 desktop -->
        <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory w-full max-w-3xl lg:max-w-6xl sm:grid sm:grid-cols-2 lg:grid-cols-3 sm:gap-5 sm:overflow-x-visible sm:pb-0 lg:gap-7">
          {workshops.map((w) => (
            <div class="shrink-0 w-[260px] snap-start sm:w-auto bg-white border border-[#dbdbdb] rounded-[12px] shadow-[0px_1px_8px_rgba(168,168,168,0.25)] flex flex-col overflow-hidden">
              <div class="relative h-[190px] bg-[#acb8a9]">
                {photo(w.id) && (
                  <img
                    src={photo(w.id).src}
                    alt={card(w).title}
                    class="w-full h-full object-cover"
                    style={`object-position: ${photo(w.id).position}`}
                  />
                )}
                <span class="font-fraunces absolute top-3 left-1/2 -translate-x-1/2 text-white text-[18px] font-bold text-center w-[90%] leading-tight drop-shadow-md">
                  {card(w).title}
                </span>
              </div>
              <div class="p-4 flex flex-col gap-2 flex-1">
                <p class="font-aileron text-[#0698c0] text-[17px] font-bold leading-snug">
                  {card(w).subtitle || card(w).title}
                </p>
                <div class="flex flex-col gap-5 flex-1 justify-between">
                  <p class="font-aileron text-[#3b3b3b] text-[15px] leading-snug">
                    {card(w).description}
                  </p>
                  <a
                    href="#"
                    data-coming-soon
                    class="font-aileron bg-[#f05600] text-white text-[15px] font-semibold h-[46px] flex items-center justify-center rounded-[7px] hover:bg-orange-700 transition-colors"
                  >
                    {t(lang, "workshops.learnMore")}
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── WORKSHOP FORMATS ─── -->
    <section class="py-12 lg:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col gap-10 lg:gap-14 items-center">

        <h2 class="font-fraunces text-[24px] lg:text-[32px] font-semibold text-center leading-tight">
          {t(lang, "formats.heading1")}<br />
          <span class="text-[#f05600]">{t(lang, "formats.heading2")}</span>
        </h2>

        <!-- 6 features box -->
        <div class="w-full border-4 border-[#0698c0] rounded-[17px] bg-[rgba(6,152,192,0.05)] shadow-[0px_0px_7px_rgba(168,168,168,0.25)] p-5 lg:p-6">
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            {features.map((f) => (
              <div class="flex flex-col items-center gap-2 py-3 lg:py-4 px-3 text-center">
                <img src={f.icon} alt="" class="w-[44px] h-[44px] lg:w-[52px] lg:h-[52px]" />
                <p class="font-aileron text-black text-[14px] lg:text-[15px] font-bold leading-snug">{f.label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Workshop list -->
        <div class="flex flex-col gap-5 lg:gap-6 w-full">
          {[
            { img: "/assets/images/activities/workshop-lionel.jpg", title: t(lang, "formats.workshopTitle"),    desc: t(lang, "formats.workshopDesc") },
            { img: "/assets/images/activities/masterclass-lionel.jpg", title: t(lang, "formats.masterclassTitle"), desc: t(lang, "formats.masterclassDesc") },
            { img: "/assets/images/activities/marche-oceane.jpg",      title: t(lang, "formats.oceanWalkTitle"),   desc: t(lang, "formats.oceanWalkDesc") },
          ].map((f) => (
            <div class="bg-white border border-[#d9d9d9] rounded-[13px] shadow-[0px_0px_8px_rgba(173,173,173,0.25)] flex flex-col sm:flex-row items-stretch overflow-hidden min-h-[130px] sm:h-[160px]">
              <div class="shrink-0 w-full sm:w-[160px] h-[130px] sm:h-full">
                <img src={f.img} alt={f.title} class="w-full h-full object-cover sm:rounded-bl-[13px] sm:rounded-tl-[13px]" />
              </div>
              <div class="flex flex-col gap-1 px-5 py-3 flex-1">
                <p class="font-fraunces text-[#f05600] text-[15px] lg:text-[16px] font-bold">{f.title}</p>
                <p class="font-aileron text-black text-[13px] lg:text-[14px] font-medium leading-[22px]">{f.desc}</p>
              </div>
            </div>
          ))}

          <a
            href="#"
            data-coming-soon
            class="font-aileron bg-[#0698c0] text-white text-[16px] lg:text-[18px] font-semibold h-[48px] flex items-center justify-center rounded-[7px] w-full hover:bg-cyan-700 transition-colors"
          >
            {t(lang, "formats.seeAll")}
          </a>
        </div>
      </div>
    </section>

    <!-- ─── STATS ─── -->
    <section class="relative py-16 lg:py-24 overflow-hidden">
      <div class="absolute inset-0">
        <img src="/assets/figma/stats-bg.png" alt="" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/40"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 flex flex-col items-center gap-8 lg:gap-10">
        <div class="flex flex-col items-center gap-4 lg:gap-5 text-center">
          <div class="bg-[rgba(6,152,192,0.53)] px-6 h-[44px] flex items-center justify-center rounded-full">
            <span class="text-[#47cdf2] text-[13px] lg:text-[15px] font-semibold">{t(lang, "badge.science")}</span>
          </div>
          <p class="font-fraunces text-[22px] lg:text-[32px] font-semibold text-white text-center leading-snug max-w-[640px]">
            <span class="text-[#47cdf2]">{t(lang, "stats.heading2")}</span> {t(lang, "stats.heading3")} <span class="text-[#f05600]">{t(lang, "stats.heading4")}</span>
          </p>
        </div>
        <div class="flex flex-col md:flex-row gap-10 md:gap-20 items-center justify-center text-center">
          {STATS.map((s) => (
            <div class="flex flex-col items-center gap-2 lg:gap-3">
              <StatCounter value={s.value} class="font-fraunces text-[44px] lg:text-[72px] font-semibold text-white leading-none" />
              <span class="font-aileron text-[20px] lg:text-[28px] font-semibold text-[#47cdf2]">{t(lang, s.labelKey)}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── 6 REASONS ─── -->
    <section id="reasons" class="py-12 lg:py-16 bg-white scroll-mt-16 lg:scroll-mt-20">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col gap-7 lg:gap-9">

        <!-- Header -->
        <div class="flex flex-col gap-4 lg:gap-5">
          <div class="bg-[#0698c0] px-6 h-[44px] flex items-center justify-center rounded-full self-start">
            <span class="text-white text-[13px] lg:text-[15px] font-semibold">{t(lang, "badge.science")}</span>
          </div>
          <h2 class="font-fraunces text-[24px] lg:text-[34px] font-semibold leading-tight">
            {t(lang, "reasons.heading1")} <span class="text-[#f05600]">{t(lang, "reasons.heading2")}</span> {t(lang, "reasons.heading3")} <span class="text-[#f05600]">{t(lang, "reasons.heading4")}</span>
          </h2>
          <div class="font-aileron flex flex-col gap-3 text-[15px] lg:text-[17px] font-medium text-black">
            <p>{t(lang, "reasons.body1")}</p>
            <p>{t(lang, "reasons.body2")}</p>
          </div>
        </div>

        <!-- Reason cards — 3×2 grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {reasons.map((r, i) => (
            <div class="border border-[#d9d9d9] rounded-[14px] bg-white p-6 lg:p-7 flex flex-col gap-4 shadow-sm">
              <div class="flex items-center gap-4">
                <span class="font-fraunces text-[48px] lg:text-[56px] font-bold text-[#0698c0] leading-none shrink-0">{i + 1}</span>
                <p class="font-fraunces text-[16px] lg:text-[17px] font-bold text-black leading-snug">
                  {r.title} <span class="text-[#f05600]">{r.accent}</span>
                </p>
              </div>
              <div class="font-aileron text-[14px] lg:text-[15px] text-[#3b3b3b] leading-snug flex flex-col gap-1">
                {r.text.split("\n").map((line: string) => <p>{line}</p>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
</Layout>
