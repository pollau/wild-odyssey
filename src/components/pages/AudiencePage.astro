---
// Page destinee a un public de l'onglet Education : enseignement superieur
// (/universites) ou ecoles (/ecoles). Elle compose les memes cinq sections que
// la home, dans le meme ordre, mais chaque public lit ses propres fiches : le
// public change, pas la structure.
//
// Seule la bande de chiffres est partagee avec la home, singleton compris :
// memes nombres, memes legendes, un seul endroit ou les corriger.
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import { t } from "../../i18n/ui";
import { langBlock } from "../../i18n/langBlock";
import { plainText } from "../../i18n/richText";
import Hero from "../sections/Hero.astro";
import Thematics from "../sections/Thematics.astro";
import Sessions from "../sections/Sessions.astro";
import Stats from "../sections/Stats.astro";
import Reasons from "../sections/Reasons.astro";
import universityThematicsUi from "../../content/ui/university-thematics.json";
import universitySessionsUi from "../../content/ui/university-sessions.json";
import universityReasonsUi from "../../content/ui/university-reasons.json";
import schoolsThematicsUi from "../../content/ui/schools-thematics.json";
import schoolsSessionsUi from "../../content/ui/schools-sessions.json";
import schoolsReasonsUi from "../../content/ui/schools-reasons.json";
import statsUi from "../../content/ui/stats.json";

interface Props {
  audience: "university" | "schools";
  lang: string;
}

const { audience, lang } = Astro.props;

// Tout ce qui distingue un public d'un autre. Les noms de collections restent
// ecrits en toutes lettres pour qu'Astro en connaisse le type.
const PUBLICS = {
  university: {
    intro: "university",
    thematics: "university-thematics",
    sessions: "university-sessions",
    reasons: "university-reasons",
    ui: { thematics: universityThematicsUi, sessions: universitySessionsUi, reasons: universityReasonsUi },
    seo: { title: "seo.university.title", description: "seo.university.description" },
  },
  schools: {
    intro: "schools",
    thematics: "schools-thematics",
    sessions: "schools-sessions",
    reasons: "schools-reasons",
    ui: { thematics: schoolsThematicsUi, sessions: schoolsSessionsUi, reasons: schoolsReasonsUi },
    seo: { title: "seo.schools.title", description: "seo.schools.description" },
  },
} as const;
const p = PUBLICS[audience];

const intro = (await getEntry(p.intro, "index"))!.data;

const parRang = (a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id);
const thematics = (await getCollection(p.thematics)).sort(parRang);
const sessions = (await getCollection(p.sessions)).sort(parRang);
const reasons = (await getCollection(p.reasons)).sort(parRang);

const stats = langBlock(statsUi, lang);
---

<Layout title={plainText(t(lang, p.seo.title))} description={plainText(t(lang, p.seo.description))} alternates>
  <main class="pt-[80px]">
    <Hero intro={langBlock(intro, lang)} ctaHref="#reasons" />
    <Thematics chrome={langBlock(p.ui.thematics, lang)} cards={thematics} lang={lang} />
    <Sessions chrome={langBlock(p.ui.sessions, lang)} cards={sessions} lang={lang} />
    <Stats chrome={stats} />
    <Reasons chrome={langBlock(p.ui.reasons, lang)} badgeScience={stats.badgeScience} cards={reasons} lang={lang} />
  </main>
</Layout>
