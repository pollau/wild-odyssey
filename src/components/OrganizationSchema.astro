---
import footerUi from "../content/ui/footer.json";

// Organization structured data (schema.org) — placed on the homepage per Google's guidance.
const email = footerUi.contactEmail;
const site = Astro.site ?? new URL("https://www.wildodyssey.org");

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Wild Odyssey",
  url: site.href,
  logo: new URL("/assets/images/brand/logo-full.png", site).href,
  description:
    "Wild Odyssey designs science-based awareness workshops (climate, ocean, biodiversity, carbon footprint) that engage teams and turn awareness into action.",
  email,
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email,
    availableLanguage: ["French", "English", "Spanish"],
  },
  // sameAs: social profile URLs — add LinkedIn / Instagram / etc. once available.
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
