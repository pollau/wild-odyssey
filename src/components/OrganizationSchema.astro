---
import footerUi from "../content/ui/footer.json";
import seoUi from "../content/ui/seo.json";

// Organization structured data (schema.org) — placed on the homepage per Google's guidance.
const email = footerUi.contactEmail;
// La fiche part sur les trois accueils : elle doit parler la langue de la page.
const schemaLang = (Astro.currentLocale ?? "fr") as "fr" | "en" | "es";
const site = Astro.site ?? new URL("https://www.wildodyssey.org");

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Wild Odyssey",
  url: site.href,
  logo: new URL("/assets/images/brand/logo-full.png", site).href,
  description: seoUi[schemaLang].organization,
  email,
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email,
    availableLanguage: ["French", "English", "Spanish"],
  },
  // sameAs: social profile URLs — add LinkedIn / Instagram / etc. once available.
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
