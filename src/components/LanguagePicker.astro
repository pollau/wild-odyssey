---
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  // True only for pages that exist in all three locales. When false the picker
  // targets each locale home, so it never links to a path that would 404.
  alternates?: boolean;
}

const { alternates = false } = Astro.props;

const currentLocale = Astro.currentLocale || 'fr';

// Strip locale prefix to get the bare path, then rebuild per locale
const rawPath = Astro.url.pathname;
const strippedPath = rawPath.replace(/^\/(en|es)(\/|$)/, '/') || '/';

// A page that exists in every locale keeps its path for all three entries.
// On an untranslated page only the current locale can keep it — the others
// would point at a URL that does not exist.
const pathFor = (code: string) => (alternates || code === currentLocale ? strippedPath : '/');

const languages = {
  fr: { code: 'fr', flag: 'https://flagcdn.com/w40/fr.png', label: 'FR', name: 'Français' },
  en: { code: 'en', flag: 'https://flagcdn.com/w40/us.png', label: 'EN', name: 'English (US)' },
  es: { code: 'es', flag: 'https://flagcdn.com/w40/es.png', label: 'ES', name: 'Español' },
};
---

<div class="relative z-50 lang-picker-component">
    <button class="lang-toggle flex items-center gap-2 bg-white/10 hover:bg-white/20 px-3 py-2 rounded-full transition-colors backdrop-blur-sm">
        <img src={languages[currentLocale]?.flag} alt={languages[currentLocale]?.label} class="w-6 h-4 object-cover rounded-sm" />
        <span class="text-sm font-medium text-black">{languages[currentLocale]?.label}</span>
        <svg class="w-4 h-4 text-black transition-transform duration-200 lang-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
    </button>
    
    <div class="lang-dropdown hidden absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl transition-all duration-200 transform origin-top-right overflow-hidden border border-gray-100">
        <ul class="py-1">
            {Object.values(languages).map((lang) => (
                <li>
                    <a
                        href={getRelativeLocaleUrl(lang.code, pathFor(lang.code))}
                        class={`block px-4 py-3 text-sm flex items-center gap-3 hover:bg-gray-50 transition-colors ${currentLocale === lang.code ? 'font-bold text-primary bg-blue-50' : 'text-gray-700'}`}
                        onclick={`localStorage.setItem('wild_odyssey_lang', '${lang.code}')`}
                    >
                        <img src={lang.flag} alt={lang.label} class="w-6 h-4 object-cover rounded-sm shadow-sm" />
                        <span>{lang.name}</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</div>

<script>
    // Logic for Language Dropdown (supports multiple instances)
    const pickers = document.querySelectorAll('.lang-picker-component');

    pickers.forEach(picker => {
        const btn = picker.querySelector('.lang-toggle');
        const menu = picker.querySelector('.lang-dropdown');
        const arrow = picker.querySelector('.lang-arrow');

        btn?.addEventListener('click', (e) => {
            e.stopPropagation();
            // Close other open pickers first? Optional but cleaner.
            pickers.forEach(p => {
                if (p !== picker) {
                    p.querySelector('.lang-dropdown')?.classList.add('hidden');
                    p.querySelector('.lang-arrow')?.classList.remove('rotate-180');
                }
            });
            
            menu?.classList.toggle('hidden');
            arrow?.classList.toggle('rotate-180');
        });

        // Close on click outside
        document.addEventListener('click', (e) => {
            if (menu && !picker.contains(e.target as Node)) {
                menu.classList.add('hidden');
                arrow?.classList.remove('rotate-180');
            }
        });
    });

    // Client-side auto-redirect on root only
    if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
        const storedLang = localStorage.getItem('wild_odyssey_lang');
        const browserLang = navigator.language.split('-')[0];
        const targetLang = storedLang || (['en', 'es'].includes(browserLang) ? browserLang : 'fr');
        
        if (targetLang !== 'fr') {
             // Redirect to preferred language if not french (default)
            window.location.href = `/${targetLang}/`;
        }
    }
</script>
