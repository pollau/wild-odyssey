---
// Rendu EN PARAGRAPHES d'un texte du CMS : chaque retour a la ligne ouvre un
// nouveau <p>, qui recoit la classe passee. Remplace le <p> qu'on aurait
// ecrit a la main, pour ne jamais imbriquer un paragraphe dans un autre.
// Voir src/i18n/richText.ts pour la convention d'ecriture.
import { ACCENTS, parseParagraphs } from "../i18n/richText";

interface Props {
	text?: string;
	class?: string;
}

const { text = "", class: classe } = Astro.props;
const paragraphes = parseParagraphs(text);
---
{paragraphes.map((segments) => (
	<p class={classe}>
		{segments.map((s) =>
			s.accent === "none" ? s.text : <span class={ACCENTS[s.accent].classe}>{s.text}</span>
		)}
	</p>
))}
